<?xml version="1.0" encoding="utf-8"?>
<!-- Full screen on a 1080p TV (960 x 540 dp). Noirly Warm Gold, dark: a near-black page with a faint glow in the
     weather's colour (Forecast.backdrop); Inter Display for figures, Hanken Grotesk for copy, JetBrains Mono for labels. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0A08">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="48dp"
        android:paddingEnd="64dp"
        android:visibility="invisible">

        <TextView
            android:id="@+id/place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/noirly_mono_medium"
            android:letterSpacing="0.22"
            android:singleLine="true"
            android:textAllCaps="true"
            android:textColor="#7DF5F3EA"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noirly_inter_bold"
                android:includeFontPadding="false"
                android:letterSpacing="-0.04"
                android:textColor="#FFF5F3EA"
                android:textSize="104sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sky"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/noirly_inter_bold"
                    android:letterSpacing="-0.02"
                    android:textColor="#FFF5F3EA"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/feels"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/noirly_hanken_regular"
                    android:textColor="#ADF5F3EA"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/airQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/noirly_mono_medium"
            android:letterSpacing="0.06"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:maxWidth="560dp"
        android:fontFamily="@font/noirly_hanken_regular"
        android:text="@string/loading"
        android:textColor="#ADF5F3EA"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="64dp"
        android:paddingEnd="64dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/changeCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill"
            android:focusable="true"
            android:fontFamily="@font/noirly_mono_medium"
            android:letterSpacing="0.14"
            android:paddingStart="22dp"
            android:paddingTop="12dp"
            android:paddingEnd="22dp"
            android:paddingBottom="12dp"
            android:text="@string/change_city"
            android:textAllCaps="true"
            android:textColor="@color/pill_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:fontFamily="@font/noirly_mono_medium"
            android:letterSpacing="0.08"
            android:textColor="#7DF5F3EA"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
