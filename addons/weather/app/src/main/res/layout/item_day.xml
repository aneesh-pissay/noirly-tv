<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:background="@drawable/day_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dayName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/noirly_mono_medium"
        android:letterSpacing="0.16"
        android:textAllCaps="true"
        android:textColor="#7DF5F3EA"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/daySky"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:fontFamily="@font/noirly_hanken_regular"
        android:singleLine="true"
        android:textColor="#ADF5F3EA"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/dayTemps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/noirly_inter_bold"
        android:letterSpacing="-0.02"
        android:textColor="#FFF5F3EA"
        android:textSize="26sp" />
</LinearLayout>
